msgstr ""

#. type: Content of: <section><reading-questions><exercise><matches><match><response>
#: source/sec_seq-growth.ptx:990 source/sec_seq-arithgeom.ptx:949
#, no-wrap
msgid "Geometric; closed"
msgstr ""

#. type: Content of: <section><reading-questions><exercise><matches><match><premise>
#: source/sec_seq-growth.ptx:992
#, no-wrap
msgid "      <m>a_n = 3a_{n-1}</m>"
msgstr ""

#. type: Content of: <section><reading-questions><exercise><matches><match><response>
#: source/sec_seq-growth.ptx:992 source/sec_seq-arithgeom.ptx:953
#, no-wrap
msgid "Geometric; recursive"
msgstr ""

#. type: Content of: <section><reading-questions><exercise><statement><p>
#: source/sec_seq-growth.ptx:998
#, no-wrap
msgid ""
"          How can you decide whether a sequence is the sequence of partial sums of an arithmetic or geometric sequence?  Describe what you would do to check, using an example.\n"
"        "
msgstr ""

