#. type: Content of: <section><subsection><program><input>
#: source/sec_counting-probability.ptx:70
#, no-wrap
msgid ""
"import random\n"
"\n"
"for i in range(4):\n"
"    die = random.randint(1,6)\n"
"    print(f\"You rolled a {die}\")\n"
"\n"
"#for i in range(24):\n"
"#    die1 = random.randint(1,6)\n"
"#    die2 = random.randint(1,6)\n"
"#    print(f\"You rolled a {die1} and a {die2}\")\n"
