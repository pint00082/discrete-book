#. type: Content of: <section><subsection><paragraphs><title>
#: source/sec_gt-intro.ptx:1379
#, no-wrap
msgid ""
"Graph\n"
"      Theory Definitions"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p>
#: source/sec_gt-intro.ptx:1381
#, no-wrap
msgid ""
" There are a lot of definitions to keep track of in graph theory.\n"
"      Here is a glossary of the terms we have already used and will soon encounter. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1392
#, no-wrap
msgid ""
" A collection of <term>vertices</term>,\n"
"      some of which are connected by <term>edges</term>. More precisely, a pair of sets <m>V</m> and <m>E</m>,\n"
"      where <m>V</m> is a set of vertices and <m>E</m> is a set of 2-element subsets of <m>V</m>. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1399
#, no-wrap
msgid "      Adjacent"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1407
#, no-wrap
msgid ""
" Two vertices are <term>adjacent</term> if they are\n"
"      connected by an edge. Two edges are <term>adjacent</term> if they share a vertex. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1412
#, no-wrap
msgid ""
"Bipartite\n"
"      graph"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1419
#, no-wrap
msgid ""
"            A graph for which it is possible to divide the vertices into two disjoint sets such that\n"
"      there are no edges between any two vertices in the same set.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1425
#, no-wrap
msgid ""
"Complete\n"
"      bipartite graph"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1435
#, no-wrap
msgid ""
"      A bipartite graph for which every vertex in the first set is adjacent to every vertex in the\n"
"      second set.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1441
#, no-wrap
msgid ""
"Complete\n"
"      graph"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1451
#, no-wrap
msgid ""
"            A graph in which every pair of vertices is adjacent.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1457
#, no-wrap
msgid "      Connected"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1462
#, no-wrap
msgid ""
" A\n"
"      graph is <term>connected</term> if there is a path from any vertex to any other vertex. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1467
#, no-wrap
msgid ""
"Chromatic\n"
"      number"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1477
#, no-wrap
msgid ""
"      The minimum number of colors required in a proper vertex coloring of the graph.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1483
#, no-wrap
msgid "      Cycle"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1492
#, no-wrap
msgid ""
"            A path (see below) that starts and stops at the same vertex, but contains no other\n"
"      repeated vertices.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1498
#, no-wrap
msgid ""
"Degree\n"
"      of a vertex"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1507
#, no-wrap
msgid ""
"      The number of edges incident to a vertex.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1512
#, no-wrap
msgid ""
"Euler\n"
"            trail"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1519
#, no-wrap
msgid ""
"            A walk which uses each edge exactly once.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1524
#, no-wrap
msgid ""
"Euler\n"
"      circuit"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1534
#, no-wrap
msgid ""
"            An Euler trail which starts and stops at the same vertex.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1540
#, no-wrap
msgid "      Multigraph"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1545
#, no-wrap
msgid ""
" A <term>\n"
"      multigraph</term> is just like a graph but can contain multiple edges between two vertices as\n"
"      well as single edge loops (that is an edge from a vertex to itself). "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1551
#, no-wrap
msgid "Path"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1563
#, no-wrap
msgid ""
" A <term>path</term> is a walk that doesn't repeat any vertices (or edges)\n"
"      except perhaps the first and last. If a path starts and ends at the same vertex, it is called\n"
"      a <term>cycle</term>. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1569
#, no-wrap
msgid "Planar"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1575
#, no-wrap
msgid ""
"      A graph which can be drawn (in the plane) without any edges crossing.\n"
"          "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1581
#, no-wrap
msgid "      Subgraph"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1591
#, no-wrap
msgid ""
" We say that <m>H</m> is\n"
"      a <term>subgraph</term> of <m>G</m> if every vertex and edge of <m>H</m> is also a vertex or edge of <m>G</m>.\n"
"      We say <m>H</m> is an <term>induced</term> subgraph of <m>G</m> if every vertex of <m>H</m> is a vertex of <m>G</m>\n"
"      and each pair of vertices in <m>H</m> are adjacent in <m>H</m> if and only if they are adjacent in <m>G</m>\n"
"      . "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1599
#, no-wrap
msgid "Tree"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1614
#, no-wrap
msgid ""
" A connected graph with no cycles. (If we remove the\n"
"      requirement that the graph is connected, the graph is called a <term>forest</term>.) The vertices in\n"
"      a tree with degree 1 are called <term>leaves</term>. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1620
#, no-wrap
msgid "Vertex coloring"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1629
#, no-wrap
msgid ""
"      An assignment of colors to each of the vertices of a graph. A vertex coloring is <term>proper</term>\n"
"      if adjacent vertices are always colored differently. "
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><title>
#: source/sec_gt-intro.ptx:1634
#, no-wrap
msgid "Walk"
msgstr ""

#. type: Content of: <section><subsection><paragraphs><p><dl><li><p>
#: source/sec_gt-intro.ptx:1649
#, no-wrap
msgid ""
" A sequence of vertices such that\n"
"      consecutive vertices (in the sequence) are adjacent (in the graph). A walk in which no edge is\n"
"      repeated is called a <term>trail</term>, and a trail in which no vertex is repeated (except possibly\n"
"      the first and last) is called a <term>path</term>. "
msgstr ""

