#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/logic-proofs.ptx:574
#, no-wrap
msgid ""
"        Prove that every prime number greater than 3 is either one more or one less than a multiple of 6.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><hint><p>
