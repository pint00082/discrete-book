#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/seq-polynomial.ptx:79
#, no-wrap
msgid ""
"        Consider the sequence <m>2, 7, 15, 26, 40, 57, \\ldots</m>\n"
"        (with <m>a_0 = 2</m>).\n"
"        By looking at the differences between terms,\n"
"        express the sequence as a sequence of partial sums.\n"
"        Then find a closed formula for the sequence by computing the <m>n</m>th partial sum.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p>
#: source/exercises/seq-polynomial.ptx:88
#, no-wrap
msgid ""
"        We have <m>2 = 2</m>, <m>7 = 2+5</m>,\n"
"        <m>15 = 2 + 5 + 8</m>, <m>26 = 2+5+8+11</m>, and so on.\n"
"        The terms in the sums are given by the arithmetic sequence <m>b_n = 2+3n</m>.\n"
"        In other words, <m>a_n = \\sum_{k=0}^n (2+3k)</m>.\n"
"        To find the closed formula, we reverse and add.\n"
"        We get <m>a_n = \\frac{(4+3n)(n+1)}{2}</m>\n"
"        (we have <m>n+1</m> there because there are <m>n+1</m> terms in the sum for <m>a_n</m>).\n"
"      "
msgstr ""

