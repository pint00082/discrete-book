msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-proofs.ptx:504
#, no-wrap
msgid ""
"              Suppose you made an even amount of postage.\n"
"              Prove that you used an even number of at least one of the types of stamps.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-proofs.ptx:511
#, no-wrap
msgid ""
"              Suppose you made exactly 72 cents of postage.\n"
"              Prove that you used at least 6 of at least one type of stamp.\n"
