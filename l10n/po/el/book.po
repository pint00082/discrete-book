#: source/practice/seq-growth.ptx:26
#, no-wrap
msgid ""
"          Consider the recurrence relation <m>a_n = a_{n-1} + <var po4a-id=0></m>.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><task><statement><p>
#: source/practice/seq-growth.ptx:32 source/practice/seq-growth.ptx:93
#, no-wrap
msgid ""
"            Find the first five terms of the sequence defined by the recurrence relation and initial condition <m>a_0 = <var po4a-id=0></m>.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><task><statement><p>
#: source/practice/seq-growth.ptx:42 source/practice/seq-growth.ptx:103
#, no-wrap
msgid ""
"            Find the closed formula for the sequence defined by the recurrence relation and initial condition <m>a_0 = <var po4a-id=0></m>.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/seq-growth.ptx:45 source/practice/seq-growth.ptx:65
#: source/practice/seq-growth.ptx:106 source/practice/seq-growth.ptx:126
#: source/practice/seq-exponential.ptx:28
#, no-wrap
msgid ""
"            <m>a_n = </m><var po4a-id=0>\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><task><statement><p>
#: source/practice/seq-growth.ptx:52 source/practice/seq-growth.ptx:113
#, no-wrap
msgid ""
"            Find the first five terms of another sequence, also defined by the same recurrence relation but this time with initial condition <m>a_0 = <var po4a-id=0></m>.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><task><statement><p>
#: source/practice/seq-growth.ptx:62 source/practice/seq-growth.ptx:123
#, no-wrap
msgid ""
"            Find the closed formula for this second sequence.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><introduction><p>
#: source/practice/seq-growth.ptx:87
#, no-wrap
msgid ""
"          Consider the recurrence relation <m>a_n = <var po4a-id=0>a_{n-1}</m>.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/seq-growth.ptx:148 source/practice/seq-growth.ptx:172
