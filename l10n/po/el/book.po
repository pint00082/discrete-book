msgid "Preview Activity"
msgstr ""

#. type: Content of: <section><subsection><worksheet><introduction><p>
#: source/sec_logic-statements.ptx:244
#, no-wrap
msgid ""
"\t\t\t\tBefore reading on to the main content of the section, complete this preview activity to start thinking about the types of questions this section will address.\n"
"\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><statement><p>
#: source/sec_logic-statements.ptx:251
#, no-wrap
msgid ""
"\t\t\t\t\tWhich of the following sentences should count as statements?  That is, for which of the sentences below could you <em>potentially</em> claim the sentence was either true or false?  Select all that apply.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:258
#, no-wrap
msgid ""
"\t\t\t\t\tThe sum of the first 100 positive integers.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:264
#, no-wrap
msgid ""
"\t\t\t\t\tThis is not a statement.\n"
"\t\t\t\t\tIt is not even a complete sentence (there is no verb).\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:272
#, no-wrap
msgid ""
"\t\t\t\t\tWhat is the sum of the first 100 positive integers?\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:278
#, no-wrap
msgid ""
"\t\t\t\t\tThis is a question.\n"
"\t\t\t\t\tIt is not a statement.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:286
#, no-wrap
msgid ""
"\t\t\t\t\tThe sum of the first 100 positive integers is 5050.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:292
#, no-wrap
msgid ""
"\t\t\t\t\tThis is a statement.\n"
"\t\t\t\t\tIt is either true or false (it happens to be true).\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:300
#, no-wrap
msgid ""
"\t\t\t\t\tIs the sum of the first 100 positive integers 5050?\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:306
#, no-wrap
msgid ""
"\t\t\t\t\tThis is a question.\n"
"\t\t\t\t\tThe answer happens to be <q>yes</q>, but that is not the same as saying <q>true</q>.\n"
"\t\t\t\t\tQuestions are never statements.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:315
#, no-wrap
msgid ""
"\t\t\t\t\tThe sum of the first 100 positive integers is 17.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:321
#, no-wrap
msgid ""
"\t\t\t\t\tThis is clearly false.\n"
"\t\t\t\t\tBut since it is false, it is a statement!\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><statement><p>
#: source/sec_logic-statements.ptx:332
#, no-wrap
msgid ""
"\t\t\t\t\tYou and your roommate are arguing, and they make the audacious claim that pineapple is good both on pizza and in smoothies.  Which of the following are reasonable responses to this claim, from a logical point of view?\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:339
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because even though pineapple is good in smoothies, it is NOT good on pizza.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:344
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tIf you really think that pineapple is not good on pizza, then you would have to say the statement is false.  The statement is claiming both are true.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:351
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because while pineapple is good on pizza and pineapple is good in smoothies, a pizza smoothie is never good.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:356
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe claim that pineapple is good both on pizza and in smoothies is not claiming that it is only good at the same time.  It is precisely claiming these two separate facts are both true.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:363
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is half true because regardless of what you think about pineapple on pizza, we can all agree at least that pineapple is good in smoothies.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:368
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tStatements are either true or false.  There is no <q>half true.</q>.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:375
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because everyone who likes pineapple on pizza does NOT like pineapple in smoothies.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:380
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tIf it were the case that everyone who liked pineapple on pizza didn't like pineapple in smoothies, then the statement would indeed be false.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><statement><p>
#: source/sec_logic-statements.ptx:390
#, no-wrap
msgid ""
"\t\t\t\t\tYour roommate now makes an even more outrageous claim: If a superhero movie is part of the Marvel Cinematic Universe, then it is good.  Which of the following are reasonable responses to this claim, from a logical point of view?\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:397
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThis is false because there are good superhero movies, like Wonder Woman and Dark Knight, that are based on DC Comics, and so not part of the Marvel Cinematic Universe.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:402
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe claim was that <em>if</em> a movie was Marvel, then it was good.  It is not claiming that if a movie is good, then it is Marvel.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:409
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because there is at least one superhero movie that is part of the Marvel Cinematic Universe that is also not good.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:414
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tExactly.  This is what it means for an if-then statement to be false.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:421
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because, for example, Green Lantern is neither Marvel nor good.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:426
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tActually, I've never seen that movie, but even if it were bad, that doesn't say anything about the original statement, since it is not a Marvel movie.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:433
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is true because more than half of the Marvel movies are good.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:438
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe claim was that this statement held for <em>every</em> superhero movie, not just most of them.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><statement><p>
#: source/sec_logic-statements.ptx:448
#, no-wrap
msgid ""
"\t\t\t\t\tYour roommate just won't let up with their outrageous claims.  Now they claim that either every troll is a knave, or there is at least one troll that is a knight.  What can you say to this?\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:455
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tYes, this is true because every troll is either a knight or a knave.  If it is not the case that <em>all</em> trolls are knaves, then there must be <em>some</em> troll that is a knight.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:460
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tExactly!\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:467
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThis is false because some trolls are knights and some other trolls are knaves.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:472
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tIf that were the case, there would be at least one knight.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:479
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because there is no way to verify which of the two options is the case.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:484
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tWhether it is possible to verify which part of an <q>or</q> statement is true does not change whether the statement is true.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><statement><p>
#: source/sec_logic-statements.ptx:491
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tThe statement is false because no troll could say that all trolls are knaves, since knaves always lie.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><choices><choice><feedback><p>
#: source/sec_logic-statements.ptx:496
#, no-wrap
msgid ""
"\t\t\t\t\t\t\tIt's true that if a troll said that all trolls are knaves they would have to be a knave and then it would be false that all trolls were knaves.  But luckily there is another option.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><title>
#: source/sec_logic-statements.ptx:506
#, no-wrap
msgid "Atomic and Molecular Statements"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:511
#, no-wrap
msgid ""
"\t\t\tA <term>statement</term> is any declarative sentence which is either true or false. A statement is <term>atomic</term> if it cannot be divided into smaller statements, otherwise it is called <term>molecular</term>.\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p>
#: source/sec_logic-statements.ptx:517
#, no-wrap
msgid ""
"\t\t\t\t\tThese are statements (in fact,\n"
"\t\t\t\t\t<em>atomic</em> statements):\n"
"\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:522
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tTelephone numbers in the USA have 10 digits.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:528
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tThe moon is made of cheese.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:534
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\t42 is a perfect square.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:540
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tEvery even number greater than 2 can be expressed as the sum of two primes.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:546
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\t<m>3+7 = 12</m>\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p>
#: source/sec_logic-statements.ptx:550
#, no-wrap
msgid ""
"\t\t\t\t\tAnd these are not statements:\n"
"\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:554
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tWould you like some cake?\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:560
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tThe sum of two squares.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li>
#: source/sec_logic-statements.ptx:565
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>1+3+5+7+\\cdots+2n+1</m>.\n"
"\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:570
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tGo to your room!\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><example><statement><p><ul><li><p>
#: source/sec_logic-statements.ptx:576
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\t<m>3+x = 12</m>\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:586
#, no-wrap
msgid ""
"\t\t\tThe reason the sentence <q><m>3 + x = 12</m></q> is not a statement is that it contains a variable. Depending on what <m>x</m> is, the sentence is either true or false, but right now it is neither. One way to make the <em>sentence</em> into a <em>statement</em> is to specify the value of the variable in some way. This could be done by setting a specific substitution, for example, <q><m>3+x = 12</m> where <m>x = 9</m>,</q> which is a true statement. Or you could <em>capture</em> the free variable by <em>quantifying</em> over it, as in, <q>For all values of <m>x</m>, <m>3+x = 12</m>,</q> which is false. We will discuss quantifiers in more detail in the subsection <xref po4a-id=0> below.\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:592
#, no-wrap
msgid ""
"\t\t\tYou can build more complicated (molecular) statements out of simpler (atomic or molecular) ones using <term>logical connectives</term>. For example, this is a molecular statement:\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><blockquote><p>
#: source/sec_logic-statements.ptx:597
#, no-wrap
msgid ""
"\t\t\t\tTelephone numbers in the USA have 10 digits, and 42 is a perfect square.\n"
"\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><p><q>
#: source/sec_logic-statements.ptx:604
#, no-wrap
msgid "\t\t\tNote that we can break this down into two smaller statements. The two shorter statements are <em>connected</em> by an <q>and.</q> We will consider 5 connectives: <q>and</q> (Sam is a man, and Chris is a woman), <q>or</q> (Sam is a man, or Chris is a woman), <q>if"
msgstr ""

#. type: Content of: <section><subsection><p><q>
#: source/sec_logic-statements.ptx:604
#, no-wrap
msgid ", then"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:604
#, no-wrap
msgid ""
"</q> (if Sam is a man, then Chris is a woman), <q>if and only if</q> (Sam is a man if and only if Chris is a woman), and <q>not</q> (Sam is not a man). The first four are called <term>binary connectives</term> (because they connect two statements) while <q>not</q> is an example of a <term>unary connective</term> (since it applies to a single statement).\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><p><idx><see>
#: source/sec_logic-statements.ptx:611 source/sec_logic-statements.ptx:612
#, no-wrap
msgid "propositional variable"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:613
#, no-wrap
msgid ""
"\t\t\tThese molecular statements are, of course, still statements, so they must be either true or false. The crucial observation here is that which <term>truth value</term> the molecular statement achieves is completely determined by the type of connective and the truth values of the parts. We do not need to know what the parts actually say or whether they have some material connection to each other, only whether those parts are true or false. \n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><p><fn>
#: source/sec_logic-statements.ptx:619
#, no-wrap
msgid ""
" In computer programming, we should call such variables\n"
"\t\t\t<term>Boolean variables</term>.\n"
"\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:619
#, no-wrap
msgid "\t\t\tTo analyze logical connectives, it is enough to consider <term>propositional variables</term> (sometimes called <em>sentential</em> variables), usually capital letters in the middle of the alphabet: <m>P, Q, R, S, \\ldots</m>. We think of these as standing in for (usually atomic) statements, but there are only two <em>values</em> the variables can achieve: true or false.<placeholder type=\"fn\" id=\"0\"/>"
msgstr ""

#. type: Content of: <section><subsection><p><notation><usage>
#: source/sec_logic-statements.ptx:622
#, no-wrap
msgid "<m>P, Q, R, S, \\ldots</m>"
msgstr ""

#. type: Content of: <section><subsection><p><notation><description>
#: source/sec_logic-statements.ptx:623
#, no-wrap
msgid "propositional (sentential) variables"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:625
#, no-wrap
msgid ""
"\t\t\tWe also have symbols for the logical connectives: <m>\\wedge</m>, <m>\\vee</m>, <m>\\imp</m>, <m>\\iff</m>, <m>\\neg</m>.\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><title>
#: source/sec_logic-statements.ptx:629
#, no-wrap
msgid "Logical Connectives"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p>
#: source/sec_logic-statements.ptx:634
#, no-wrap
msgid ""
"\t\t\t\t\tWe define the following <term>logical connectives</term>.\n"
"\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:637
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\wedge Q</m> is read <q><m>P</m> and <m>Q</m>,</q>\n"
"\t\t\t\t\t\t\tand is called a <term>conjunction</term>.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><usage>
#: source/sec_logic-statements.ptx:642
#, no-wrap
msgid "<m>\\wedge</m>"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><description>
#: source/sec_logic-statements.ptx:643
#, no-wrap
msgid "logical <q>and</q> (conjunction)"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:650
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\vee Q</m> is read <q><m>P</m> or <m>Q</m>,</q>\n"
"\t\t\t\t\t\t\tand is called a <term>disjunction</term>.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><usage>
#: source/sec_logic-statements.ptx:653
#, no-wrap
msgid "<m>\\vee</m>"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><description>
#: source/sec_logic-statements.ptx:654
#, no-wrap
msgid "logical <q>or</q> (disjunction)"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:659
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\imp Q</m> is read <q>if <m>P</m> then <m>Q</m>,</q>\n"
"\t\t\t\t\t\t\tand is called an <term>implication</term>\n"
"\t\t\t\t\t\t\tor <term>conditional</term>.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:669
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\iff Q</m> is read <q><m>P</m> if and only if <m>Q</m>,</q>\n"
"\t\t\t\t\t\t\tand is called a <term>biconditional</term>.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><idx><see>
#: source/sec_logic-statements.ptx:673
#, no-wrap
msgid "if and only if"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:677
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>\\neg P</m> is read <q>not <m>P</m>,</q>\n"
"\t\t\t\t\t\t\tand is called a <term>negation</term>.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><usage>
#: source/sec_logic-statements.ptx:682
#, no-wrap
msgid "<m>\\neg</m>"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li><notation><description>
#: source/sec_logic-statements.ptx:683
#, no-wrap
msgid "logical negation"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:693
#, no-wrap
msgid ""
"\t\t\tThe\n"
"\t\t\t<term>truth value</term> of a statement is determined by the truth value(s) of its part(s),\n"
"\t\t\tdepending on the connectives:\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><title>
#: source/sec_logic-statements.ptx:699
#, no-wrap
msgid "Truth Conditions for Connectives"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p>
#: source/sec_logic-statements.ptx:703
#, no-wrap
msgid ""
"\t\t\t\t\tThe <term>truth conditions</term> for the logical connectives are defined as follows.\n"
"\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:706
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\wedge Q</m> is true when both <m>P</m> and <m>Q</m> are true.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:715
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\vee Q</m> is true when <m>P</m> or <m>Q</m> or both are true.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:724
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\imp Q</m> is true when <m>P</m> is false or <m>Q</m> is true (or both).\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:737
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>P \\iff Q</m> is true when <m>P</m> and <m>Q</m> are both true,\n"
"\t\t\t\t\t\t\tor both false.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><definition><statement><p><ul><li>
#: source/sec_logic-statements.ptx:747
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t<m>\\neg P</m> is true when <m>P</m> is false.\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><p>
#: source/sec_logic-statements.ptx:758
#, no-wrap
msgid ""
"\t\t\tEach of the above definitions can be represented in a table, called a <term>truth table</term>.  We simply list what the truth value of the statement is for each possible combination of truth values of the parts.\n"
"\t\t"
msgstr ""

#. type: Content of: <section><subsection><figure><caption>
#: source/sec_logic-statements.ptx:761
#, no-wrap
msgid "Truth tables for logical connectives."
msgstr ""

