#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:115
#, no-wrap
msgid ""
"              How many ways are there to distribute 8 cookies to 3 kids?\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:121
#, no-wrap
msgid ""
"              How many solutions in non-negative integers are there to\n"
"              <m>x+y+z = 8</m>?\n"
