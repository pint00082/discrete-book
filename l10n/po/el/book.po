"        (you may reference\n"
"        <xref po4a-id=0>Question</xref>).\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p>
#: source/exercises/logic-conc.ptx:91
#, no-wrap
msgid ""
"        Peter is not tall, and Robert is not skinny.\n"
"        You must be in row 6 in the truth table above.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/logic-conc.ptx:100
#, no-wrap
msgid ""
"        Are the statements <m>P \\imp (Q \\vee R)</m> and\n"
"        <m>(P \\imp Q) \\vee (P \\imp R)</m> logically equivalent?\n"
"        Explain your answer.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p>
#: source/exercises/logic-conc.ptx:107
#, no-wrap
msgid ""
