#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:82
#, no-wrap
msgid ""
"          Let's prove that <m>K_{<var po4a-id=0>}</m> is not planar:\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:85
#, no-wrap
msgid ""
"          First, how many vertices and how many edges does <m>K_{<var po4a-id=0>}</m> have?\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:89
#, no-wrap
msgid ""
"          <m>v = </m> <var po4a-id=0> and <m>e = </m> <var po4a-id=1>.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:93
#, no-wrap
msgid ""
"          If we assume that <m>K_{<var po4a-id=0>}</m> were planar, then how many faces <em>would</em> it have?\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:97
#, no-wrap
msgid ""
"          <m>f = </m> <var po4a-id=0>.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:101
#, no-wrap
msgid ""
"          However, since every face is bounded by at least <var po4a-id=0> edges, and every edge borders exactly <var po4a-id=1> faces, we can get a bound on the number of faces.  What is the largest number of faces possible based on this line of reasoning?\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:105
#, no-wrap
msgid ""
"          <m>f \\le </m> <var po4a-id=0>.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:109
#, no-wrap
msgid ""
"          This is a contradiction, so <m>K_{<var po4a-id=0>}</m> is not planar.  QED.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/practice/gt-planar.ptx:124
#, no-wrap
msgid ""
