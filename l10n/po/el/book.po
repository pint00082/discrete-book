#. type: Content of: <exercises><exercise><statement><p>
#: source/practice/logic-proofs.ptx:10
#, no-wrap
msgid ""
"        Arrange some of the statements below to form a correct proof of the following statement: <q>For any integer <m>n</m>, if <m>n</m> is even, then <m>7n</m> is even.</q>\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><blocks><block><p>
#: source/practice/logic-proofs.ptx:16
#, no-wrap
msgid ""
"          Let <m>n</m> be an arbitrary integer, and assume <m>n</m> is even.\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><blocks><block><p>
#: source/practice/logic-proofs.ptx:21
#, no-wrap
msgid ""
"          Since the product of any number with an even number is even,\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><blocks><block><p>
#: source/practice/logic-proofs.ptx:26
#, no-wrap
msgid ""
