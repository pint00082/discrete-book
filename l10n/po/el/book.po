"\t\t\t\t\t\t\t\t\t\t<var po4a-id=0>\n"
"\t\t\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><statement><p><ol><li><p>
#: source/sec_counting-combine-outcomes.ptx:76
#, no-wrap
