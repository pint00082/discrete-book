#: source/exercises/intro-sets.ptx:158
#, no-wrap
msgid ""
"                <m>|A|</m> when <m>A = \\{<var po4a-id=0>, <var po4a-id=1>, <var po4a-id=2>, <var po4a-id=3>,\\ldots, <var po4a-id=4>\\}</m>.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p><ol><li><p>
#: source/exercises/intro-sets.ptx:166
#, no-wrap
msgid ""
"                <m>|A|</m> when <m>A = \\{x \\in \\mathbb{Z} : <var po4a-id=0> \\le x \\le <var po4a-id=1>\"\\}</m>.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p><ol><li><p>
#: source/exercises/intro-sets.ptx:174
#, no-wrap
msgid ""
"                <m>|A \\cap B|</m> when <m>A = \\{x \\in \\mathbb{N} : x \\le <var po4a-id=0>\\}</m> and <m>B = \\{x \\in \\mathbb{N} : x \\text{ is prime }\\}</m>.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/exercises/intro-sets.ptx:206
#, no-wrap
msgid ""
"          Let <m>A = \\{n \\in \\mathbb{N} : <var po4a-id=0> \\le n \\lt <var po4a-id=1>\\}</m> and <m>B = \\{n \\in \\mathbb{N} : <var po4a-id=2> \\lt n \\le <var po4a-id=3>\\}</m>.  Suppose <m>C</m> is a set such that <m>C \\subseteq A</m> and <m>C \\subseteq B</m>.  What is the largest possible cardinality of <m>C</m>?\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p>
#: source/exercises/intro-sets.ptx:242
#, no-wrap
msgid ""
"          Let <m>A = \\{x \\in \\mathbb{N} : <var po4a-id=0> \\le x \\lt <var po4a-id=1>\\}</m> and <m>B = \\{x \\in \\mathbb{N} : x \\text{ is even}\\}</m>.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p><ol><li><p>
#: source/exercises/intro-sets.ptx:246
#, no-wrap
msgid ""
"                Find <m>A \\cap B</m>.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><webwork><statement><p><ol><li><p>
#: source/exercises/intro-sets.ptx:254
#, no-wrap
msgid ""
"                Find <m>A \\setminus B</m>.\n"
"              "
