#: source/activities/four-proofs.ptx:51
#, no-wrap
msgid ""
"\t\t\tThus <m>ab</m> is even.\n"
"\t\t"
msgstr ""

#. type: Content of: <worksheet><exercise><p>
#: source/activities/four-proofs.ptx:57
#, no-wrap
msgid ""
"\t\t\tSuppose that <m>ab</m> is even but <m>a</m> and <m>b</m> are both odd.\n"
