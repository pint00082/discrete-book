#. type: Content of: <section><objectives><ol><li><p>
#: source/sec_logic-statements.ptx:14
#, no-wrap
msgid ""
"\t\t\t\t\tIdentify the logical structure of statements to determine their truth value in terms of the truth values of their parts.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><objectives><ol><li><p>
#: source/sec_logic-statements.ptx:20
#, no-wrap
msgid ""
"\t\t\t\t\tIdentify the use of quantifiers in a statement, and determine the truth value of the statement based on those quantifiers.\n"
"\t\t\t\t"
msgstr ""

#. type: Content of: <section><objectives><ol><li><p>
#: source/sec_logic-statements.ptx:26
#, no-wrap
msgid ""
"\t\t\t\t\tTranslate between statements in natural language and logical symbols.\n"
"\t\t\t\t"
msgstr ""

