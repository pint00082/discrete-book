#. type: Content of: <worksheet><exercise><p>
#: source/activities/four-proofs.ptx:23
#, no-wrap
msgid ""
"\t\t\tSuppose <m>a</m> and <m>b</m> are odd.\n"
"\t\t\tThat is, <m>a=2k+1</m> and <m>b=2m+1</m> for some integers <m>k</m> and <m>m</m>.\n"
"\t\t\tThen\n"
"\t\t\t"
msgstr ""

#. type: Content of: <worksheet><exercise><p>
#: source/activities/four-proofs.ptx:34
#, no-wrap
msgid ""
"\t\t\tTherefore <m>ab</m> is odd.\n"
"\t\t"
msgstr ""

#. type: Content of: <worksheet><exercise><p>
#: source/activities/four-proofs.ptx:40
#, no-wrap
msgid ""
"\t\t\tAssume that <m>a</m> or <m>b</m> is even -- say it is <m>a</m>\n"
"\t\t\t(the case where <m>b</m> is even will be identical).\n"
"\t\t\tThat is, <m>a=2k</m> for some integer <m>k</m>.\n"
"\t\t\tThen\n"
