#. type: Content of: <exercises><exercise><hint><p>
#: source/exercises/seq-basics.ptx:202
#, no-wrap
msgid ""
"        Write out the sequence, guess a recursive definition, and verify that the closed formula is a solution to that recursive definition.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/seq-basics.ptx:213
#, no-wrap
msgid ""
"        Use summation (<m>\\sum</m>) or product (<m>\\prod</m>) notation to rewrite the following.\n"
"\n"
