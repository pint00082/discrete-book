msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><statement><p>
#: source/practice/logic-structures.ptx:80
#, no-wrap
msgid ""
"            Let <m>a</m> be an element of <m>A</m>.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><statement><p>
#: source/practice/logic-structures.ptx:87
#, no-wrap
msgid ""
"            Let <m>a</m> be an element of <m>A \\cap B</m>. \n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><feedback><p>
#: source/practice/logic-structures.ptx:92
#, no-wrap
