#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/logic-conc.ptx:455
#, no-wrap
msgid ""
"        Consider the statement, <q>For all integers <m>n</m>,\n"
"        if <m>n</m> is even and <m>n \\le 7</m>, then <m>n</m> is negative or <m>n \\in \\{0,2,4,6\\}</m>.</q>\n"
"\n"
"        "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-conc.ptx:461
#, no-wrap
msgid ""
"              Is the statement true?\n"
"              Explain why.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-conc.ptx:468
#, no-wrap
msgid ""
"              Write the negation of the statement.\n"
"              Is it true?\n"
"              Explain.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-conc.ptx:476
#, no-wrap
msgid ""
"              State the contrapositive of the statement.\n"
"              Is it true?\n"
"              Explain.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/logic-conc.ptx:484
#, no-wrap
msgid ""
"              State the converse of the statement.\n"
"              Is it true?\n"
"              Explain.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/logic-conc.ptx:497
#, no-wrap
msgid ""
"              The statement is true.\n"
"              If <m>n</m> is an even integer less than or equal to 7, then the only way it could not be negative is if <m>n</m> was equal to 0, 2, 4, or 6.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/logic-conc.ptx:504
#, no-wrap
msgid ""
"              There is an integer <m>n</m> such that <m>n</m> is even and <m>n \\le 7</m>, but <m>n</m> is not negative and <m>n \\not\\in \\{0,2,4,6\\}</m>.\n"
"              This is false, since the original statement is true.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/logic-conc.ptx:511
#, no-wrap
msgid ""
"              For all integers <m>n</m>,\n"
"              if <m>n</m> is not negative and\n"
"              <m>n \\not\\in\\{0,2,4,6\\}</m>, then <m>n</m> is odd or <m>n &gt; 7</m>.\n"
"              This is true,\n"
"              since the contrapositive is equivalent to the original statement\n"
"              (which is true).\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/logic-conc.ptx:522
#, no-wrap
msgid ""
"              For all integers <m>n</m>,\n"
"              if <m>n</m> is negative or\n"
"              <m>n \\in \\{0,2,4,6\\}</m>, then <m>n</m> is even and <m>n \\le 7</m>.\n"
"              This is false. <m>n = -3</m> is a counterexample.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/logic-conc.ptx:536
#, no-wrap
msgid ""
"        Consider the statement:\n"
"        <m>\\forall x (\\forall y (x + y = y) \\imp \\forall z (x\\cdot z = 0))</m>.\n"
"\n"
"        "
msgstr ""

