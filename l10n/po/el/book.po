#: source/exercises/logic-conc.ptx:79
#, no-wrap
msgid ""
"        Suppose you know that the statement\n"
"        <q>if Peter is not tall,\n"
"        then Quincy is fat and Robert is skinny</q> is "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><u>
