#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_counting-combine-outcomes.ptx:113
#: source/sec_counting-combine-outcomes.ptx:123
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\t<var po4a-id=0>\n"
"\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_counting-combine-outcomes.ptx:120
#, no-wrap
msgid ""
"\t\t\t\t\t\t\t\tHow many ways can you select a card which is both a face card <em>and</em> a red card?\n"
