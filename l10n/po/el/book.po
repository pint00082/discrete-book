"          "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><statement><p>
#: source/practice/logic-statements.ptx:105
#, no-wrap
msgid ""
"            <m>\\exists x \\forall y P(x,y)</m> is true.\n"
"          "
msgstr ""

