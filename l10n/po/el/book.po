"              Suppose there is an element <m>b</m> in <m>B</m> that is not in <m>A</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><feedback><p>
#: source/practice/logic-structures.ptx:49
#, no-wrap
