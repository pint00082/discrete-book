"              Let <m>b</m> be an element of <m>B</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><statement><p>
#: source/practice/logic-structures.ptx:37
#, no-wrap
msgid ""
"              Let <m>a</m> be an element of <m>A</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><choices><choice><statement><p>
#: source/practice/logic-structures.ptx:44
#, no-wrap
