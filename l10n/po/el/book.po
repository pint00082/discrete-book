msgstr ""

#. type: Content of: <section><subsection><tabular><row><cell><line>
#: source/sec_counting-multisets.ptx:90
#, no-wrap
msgid ""
"        Prod.\n"
"        Principle"
msgstr ""

#. type: Content of: <section><subsection><tabular><row><cell><line>
#: source/sec_counting-multisets.ptx:93
#, no-wrap
msgid "        <m>n^k</m>"
msgstr ""

#. type: Content of: <section><subsection><tabular><row><cell>
#: source/sec_counting-multisets.ptx:99
#, no-wrap
msgid "No repeats"
msgstr ""

#. type: Content of: <section><subsection><tabular><row><cell><line>
#: source/sec_counting-multisets.ptx:104
#, no-wrap
