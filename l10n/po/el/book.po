#: source/practice/logic-statements.ptx:110
#, no-wrap
msgid ""
"            Careful, <m>P(x,y)</m> means <m>x</m> is less than <m>y</m>, not <m>x</m> is less than <em>or equal</em> to <m>y</m>.\n"
"          "
msgstr ""

