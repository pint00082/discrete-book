#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:24
#, no-wrap
msgid ""
"              How many ways are there to select a handful of 6 jellybeans from a jar that contains 5 different flavors?\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:30
#, no-wrap
msgid ""
"              How many ways can you distribute 5 identical lollipops to 6 kids?\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:36
#, no-wrap
msgid ""
"              How many 6-letter words can you make using the 5 vowels in alphabetical order?\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:42
#, no-wrap
msgid ""
"              How many solutions are there to the equation\n"
"              <m>x_1 + x_2 + x_3 + x_4 = 6</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:54
#, no-wrap
msgid ""
"              You take 3 strawberry, 1 lime, 0 licorice, 2 blueberry, and 0 bubblegum.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:60
#, no-wrap
msgid ""
"              This is backwards.\n"
"              We don't want the stones to represent the kids because the kids are not identical,\n"
"              but the stones are.\n"
"              Instead we should use 5 stones\n"
"              (for the lollipops)\n"
"              and use 5 sticks to switch between the 6 kids.\n"
"              For example,\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:70
#, no-wrap
msgid ""
"              would\n"
"              represent the outcome with the first kid getting 2 lollipops,\n"
"              the third kid getting 3, and the rest of the kids getting none.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:78
#, no-wrap
msgid ""
"              This is the word AAAEOO.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:84
#, no-wrap
msgid ""
"              This doesn't represent a solution.\n"
"              Each stone should represent one of the 6 units that add up to 6, and the sticks should\n"
"              <em>switch</em>\n"
"              between the different variables.\n"
"              We have one too many sticks.\n"
"              An example of a correct diagram would be\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-multisets.ptx:92
#, no-wrap
msgid ""
",\n"
"              representing that\n"
"              <m>x_1 = 1</m>,\n"
"              <m>x_2 = 2</m>,\n"
"              <m>x_3 = 0</m>, and\n"
"              <m>x_4 = 3</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/counting-multisets.ptx:108
#, no-wrap
