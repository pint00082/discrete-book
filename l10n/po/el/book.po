#. type: Content of: <exercises><exercise><statement><ol><li><p>
#: source/exercises/counting-proofs.ptx:230
#, no-wrap
msgid ""
"              Explain why <m>6 {15 \\choose 6} = 15 {14 \\choose 5}</m>.\n"
"            "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-proofs.ptx:240
#, no-wrap
msgid ""
"                She has <m>{15 \\choose 6}</m> ways to select the 6 bridesmaids,\n"
"                and then for each way, has 6 choices for the maid of honor.\n"
"                Thus she has <m>{15 \\choose 6}6</m> choices.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-proofs.ptx:248
#, no-wrap
msgid ""
"                She has 15 choices for who will be her maid of honor.\n"
"                Then she needs to select 5 of the remaining 14 friends to be bridesmaids,\n"
"                which she can do in <m>{14 \\choose 5}</m> ways.\n"
"                Thus she has <m>15 {14 \\choose 5}</m> choices.\n"
"              "
msgstr ""

#. type: Content of: <exercises><exercise><solution><p><ol><li><p>
#: source/exercises/counting-proofs.ptx:257
#, no-wrap
