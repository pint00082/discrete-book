#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/intro-sets.ptx:318
#, no-wrap
msgid ""
" Recall <m>\\Z =\n"
"        \\{\\ldots,-2,-1,0, 1,2,\\ldots\\}</m> (the integers). Let <m>\\Z^+ = \\{1, 2, 3, \\ldots\\}</m> be the\n"
"        positive integers. Let <m>2\\Z</m> be the even integers, <m>3\\Z</m> be the multiples of 3, and so\n"
"        on. "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p><ol><li><p>
#: source/exercises/intro-sets.ptx:323
#, no-wrap
