#. type: Content of: <section><title>
#: source/sec_counting-combperm.ptx:3
#, no-wrap
msgid "Combinations and Permutations"
msgstr ""

#. type: Content of: <section><objectives><ol><li><p>
#: source/sec_counting-combperm.ptx:17
#, no-wrap
msgid ""
"\t\t\t\t\tCorrectly decide between using a combination or a permutation when solving a counting problem.\n"
"\t\t\t\t"
msgstr ""

