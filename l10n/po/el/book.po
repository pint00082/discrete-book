"      "
msgstr ""

#. type: Content of: <exercises><exercise><statement><p>
#: source/exercises/logic-conc.ptx:116
#, no-wrap
msgid ""
"        Is the following a valid deduction rule?\n"
"        Explain.\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><statement><tabular><row><cell>
#: source/exercises/logic-conc.ptx:128
#, no-wrap
msgid "<m>P\\imp R</m>"
msgstr ""

#. type: Content of: <exercises><exercise><statement><tabular><row><cell>
#: source/exercises/logic-conc.ptx:132
#, no-wrap
msgid "<m>P \\imp (Q \\wedge R)</m>."
msgstr ""

#. type: Content of: <exercises><exercise><solution><p>
#: source/exercises/logic-conc.ptx:139
#, no-wrap
msgid ""
"        Make\n"
"        a truth table that includes all three statements in the argument:\n"
"      "
msgstr ""

#. type: Content of: <exercises><exercise><solution><tabular><row><cell>
#: source/exercises/logic-conc.ptx:156
#, no-wrap
msgid "<m>P \\imp R</m>"
msgstr ""

#. type: Content of: <exercises><exercise><solution><tabular><row><cell>
#: source/exercises/logic-conc.ptx:157
#, no-wrap
msgid "<m>P \\imp (Q \\wedge R)</m>"
msgstr ""

#. type: Content of: <exercises><exercise><solution><p>
#: source/exercises/logic-conc.ptx:227
#, no-wrap
msgid ""
"        Notice that in every row for which both\n"
"        <m>P \\imp Q</m> and <m>P \\imp R</m> is true,\n"
"        so is <m>P \\imp (Q \\wedge R)</m>.\n"
"        Therefore, whenever the premises of the argument are true,\n"
"        so is the conclusion.\n"
"        In other words, the deduction rule is valid.\n"
"      "
msgstr ""

