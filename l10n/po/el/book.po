"              We are going to add edges to this graph following some requirements.\n"
"            "
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_gt-trees.ptx:205
#, no-wrap
msgid ""
"                First, add the fewest number of edges possible so that the resulting graph is connected.  That is, there must be a path between any pair of vertices (a path can use more than one edge, of course).\n"
"              "
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_gt-trees.ptx:208 source/sec_gt-trees.ptx:226
#, no-wrap
msgid ""
"                How many edges are in the graph you drew?  <var po4a-id=0>\n"
"              "
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_gt-trees.ptx:215 source/sec_gt-trees.ptx:233
#, no-wrap
msgid ""
"                Was the resulting graph you found a tree?\n"
"              "
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_gt-trees.ptx:217 source/sec_gt-trees.ptx:235
#: source/sec_gt-planar.ptx:279 source/sec_gt-planar.ptx:282
#: source/sec_gt-planar.ptx:285 source/sec_gt-paths.ptx:360
