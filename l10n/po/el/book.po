"\t\t\t\t\t\t\t\t\t\tyou will eat one dish, either an appetizer or an entrée? \n"
"\t\t\t\t\t\t\t\t\t"
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><statement><p><ol><li><p>
#: source/sec_counting-combine-outcomes.ptx:71
#: source/sec_counting-combine-outcomes.ptx:79
#, no-wrap
