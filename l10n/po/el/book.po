#: source/sec_seq-exponential.ptx:139 source/sec_seq-exponential.ptx:159
#: source/sec_seq-exponential.ptx:179
#, no-wrap
msgid ""
"              <m>a_n = </m><var po4a-id=0>\n"
"            "
msgstr ""

#. type: Content of: <section><subsection><worksheet><exercise><webwork><task><statement><p>
#: source/sec_seq-exponential.ptx:146
#, no-wrap
msgid ""
"              What sequence do you get if the initial conditions are <m>a_0 = 1</m>, <m>a_1 = 3</m>?  Give the first five terms.\n"
