#. type: Content of: <exercises><exercise><solution><proof><p>
#: source/exercises/counting-proofs.ptx:320
#, no-wrap
msgid ""
"            Question: You have a large container filled with ping-pong balls,\n"
"            all with a different number on them.\n"
"            You must select <m>k</m> of the balls,\n"
"            putting two of them in a jar and the others in a box.\n"
"            How many ways can you do this?\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><solution><proof><p>
#: source/exercises/counting-proofs.ptx:328
#, no-wrap
msgid ""
"            Answer 1: First select 2 of the <m>n</m> balls to put in the jar.\n"
"            Then select <m>k-2</m> of the remaining <m>n-2</m> balls to put in the box.\n"
"            The first task can be completed in <m>{n \\choose 2}</m> different ways and\n"
"            the second task in <m>{n-2 \\choose k-2}</m> ways.\n"
"            Thus there are <m>{n \\choose 2}{n-2 \\choose k-2}</m> ways to select the balls.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><solution><proof><p>
#: source/exercises/counting-proofs.ptx:336
#, no-wrap
msgid ""
"            Answer 2: First select <m>k</m> balls from the <m>n</m> in the container.\n"
"            Then pick 2 of the <m>k</m> balls you picked to put in the jar,\n"
"            placing the remaining <m>k-2</m> in the box.\n"
"            The first task can be completed in <m>{n \\choose k}</m> ways and\n"
"            the second task in <m>{k \\choose 2}</m> ways.\n"
"            Thus there are <m>{n \\choose k}{k \\choose 2}</m> ways to select the balls.\n"
"          "
msgstr ""

#. type: Content of: <exercises><exercise><solution><proof><p>
#: source/exercises/counting-proofs.ptx:345
#, no-wrap
msgid ""
"            Since both answers count the same thing,\n"
"            they must be equal, and the identity is established.\n"
"          "
msgstr ""

